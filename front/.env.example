# Optional API origin (for local browser-to-API tests). Leave blank to use same-origin /api.
VITE_API_BASE_URL=

# Google OAuth client ID. This is a public browser identifier, not a secret.
VITE_GOOGLE_CLIENT_ID=

# Local-only fake authentication for UI/E2E; never enable in production builds.
VITE_DEV_AUTH_BYPASS=false

# Optional Web Push public key; private key stays in api/.env.
VITE_VAPID_PUBLIC_KEY=

# Backend switch for DEV, E2E and staging demonstrations. Production must keep false.
VITE_LOCAL_BACKEND_ENABLED=false
VITE_DEFAULT_BACKEND=http
