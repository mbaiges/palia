# Initial admin accounts: normalized emails are allow-listed and receive admin role on first login.
INITIAL_ADMIN_EMAILS=admin@example.org

# Browser frontend origin(s). For a single public host this is the same origin.
CLIENT_URL=http://localhost:5173

# Google OAuth server credentials. Keep secrets only in this API environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-32-byte-key

# Local development uses SQLite. Never point test or local commands at Turso.
USE_LOCAL_DB=true
DB_CONNECTION_STR=./db/data/local.db
