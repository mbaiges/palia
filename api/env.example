# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
INITIAL_ADMIN_EMAILS=admin@example.org
# Set only when the API process also serves a built frontend (combined container).
FRONT_DIST_DIR=

# JWT Configuration
JWT_SECRET=YOUR_JWT_SECRET
JWT_EXPIRES_IN=7d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Dev bypass: set DEV_AUTH_BYPASS=true to enable /auth/dev/bypass (use npm run dev:bypass)
# DEV_AUTH_BYPASS=true
# When using dev bypass, set DEV_ADMIN_EMAIL=admin@test.com to sign in as admin (e.g. for local testing)
# DEV_ADMIN_EMAIL=admin@test.com

# Email auth (sign-up, verification, forgot password)
# Disabled unless explicitly enabled (Medice login uses Google + allow-list).
EMAIL_AUTH_ENABLED=false
# Without RESEND_API_KEY: codes are logged to the terminal (local dev - no real emails sent)
# With RESEND_API_KEY: codes are sent via Resend (get key at resend.com)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=App Scaffold <noreply@yourdomain.com>
# Email auth is disabled by default for Medice; explicitly set true only if required.
# CLIENT_URL: frontend URL for email links and logo (local: http://localhost:5173, remote: override)
# LOGO_URL: optional custom logo URL for emails (defaults to CLIENT_URL/app-icon.svg)

# Database
# For Turso (production): set TURSO_DATABASE_URL and TURSO_AUTH_TOKEN
# For local dev: npm run dev sets USE_LOCAL_DB=true automatically (uses ./db/data/scaffold.db)
# To force local file when Turso vars are set: USE_LOCAL_DB=true
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-token
# USE_LOCAL_DB=true
# DB_CONNECTION_STR=./db/data/scaffold.db
ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY

# Web Push (PWA notifications)
# Generate keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Set PUSH_ENABLED=false to disable push in dev/test
PUSH_ENABLED=true
VAPID_SUBJECT=mailto:admin@example.com

# Media storage — standalone generic image assets
# Local development:
MEDIA_ENABLED=true
# MEDIA_USE_LOCAL=true
# MEDIA_LOCAL_PATH=./data/media
#
# Production can use an S3-compatible provider or Cloudflare R2:
# MEDIA_USE_LOCAL=false
#
# Filebase (S3-compatible):
# FILEBASE_ACCESS_KEY_ID=...
# FILEBASE_SECRET_ACCESS_KEY=...
# FILEBASE_BUCKET_NAME=scaffold-media
#
# Cloudflare R2 (alternative):
# R2_ACCOUNT_ID=...
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET_NAME=scaffold-media
# MEDIA_TTL_DAYS=10
# MEDIA_MAX_UPLOAD_BYTES=10485760
# MEDIA_MAX_DIMENSION=1600
# MEDIA_WEBP_QUALITY=80
# MEDIA_CLEANUP_INTERVAL_MS=21600000   # default 6h
