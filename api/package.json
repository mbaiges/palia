{
  "name": "api-node-scaffolding-auth",
  "version": "1.0.0",
  "description": "Reusable authentication and application scaffold API",
  "main": "dist/infrastructure/config/server.js",
  "scripts": {
    "start": "ts-node -r tsconfig-paths/register src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias && npx tsc knexfile.ts --outDir . --module commonjs --esModuleInterop --skipLibCheck --resolveJsonModule --allowSyntheticDefaultImports",
    "dev": "cross-env USE_LOCAL_DB=true nodemon --watch src --ext ts --exec \"npm run start\"",
    "test": "npx tsc && cross-env NODE_ENV=test USE_LOCAL_DB=true ENCRYPTION_KEY=scaffold-test-key DB_CONNECTION_STR=./db/data/jest-test.db jest --runInBand --forceExit",
    "test:profile": "npx tsc && cross-env NODE_ENV=test USE_LOCAL_DB=true ENCRYPTION_KEY=scaffold-test-key DB_CONNECTION_STR=./db/data/jest-test.db node --expose-gc --inspect-brk ./node_modules/jest/bin/jest.js --runInBand --logHeapUsage",
    "test:watch": "cross-env NODE_ENV=test USE_LOCAL_DB=true ENCRYPTION_KEY=scaffold-test-key DB_CONNECTION_STR=./db/data/jest-test.db jest --watch",
    "test:coverage": "npx tsc && cross-env NODE_ENV=test USE_LOCAL_DB=true ENCRYPTION_KEY=scaffold-test-key DB_CONNECTION_STR=./db/data/jest-test.db jest --coverage --runInBand",
    "migrate": "cross-env knex migrate:latest --knexfile knexfile.ts",
    "migrate:make": "knex migrate:make --knexfile knexfile.ts",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.ts",
    "migrate:status": "knex migrate:status --knexfile knexfile.ts",
    "assign-admin-users": "cross-env ts-node -r tsconfig-paths/register scripts/assign-admin-users.ts",
    "seed:medice": "cross-env USE_LOCAL_DB=true ts-node -r tsconfig-paths/register scripts/seed-medice.ts",
    "db:reset-turso": "ts-node -r tsconfig-paths/register scripts/reset-turso.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "smoke:load": "node scripts/smoke-load.mjs"
  },
  "keywords": [
    "nodejs",
    "express",
    "hexagonal-architecture",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@libsql/client": "^0.17.0",
    "@libsql/knex-libsql": "^0.1.0",
    "@react-email/components": "^1.0.9",
    "@react-email/render": "^2.0.4",
    "@types/cors": "^2.8.19",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/on-finished": "^2.3.5",
    "@types/uuid": "^9.0.7",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "google-auth-library": "^9.4.1",
    "googleapis": "^162.0.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^2.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "reflect-metadata": "^0.1.14",
    "resend": "^6.9.3",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "tsc-alias": "^1.8.16",
    "tsyringe": "^4.10.0",
    "typescript": "^5.3.2",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/knex": "^0.16.1",
    "@types/multer": "^2.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0"
  }
}
